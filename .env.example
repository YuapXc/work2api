# ===================================================================
# work2api 配置示例
# -------------------------------------------------------------------
# 用法：复制本文件为同目录下的 .env，取消需要的行的注释（去掉行首 #）后按需改值。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# 优先级：命令行参数 > 系统环境变量 > .env。已存在的环境变量不会被 .env 覆盖。
# 位置：.env 需放在“启动 work2api 时的工作目录”下（通常即 exe 所在目录）。
# 默认全部注释掉 —— 保持注释即使用下方标注的默认值，不改变任何行为。
# 提示：填了非法值（如把端口写成非数字）不会崩，启动时会在终端打印“⚠ 配置警告”
#       并回退默认值。含 ADMIN_TOKEN 等敏感信息，已被 .gitignore 忽略，切勿提交。
# ===================================================================


# ---- 网络 ----------------------------------------------------------

# 监听地址。默认仅本机 127.0.0.1。要让局域网/其它设备访问改为 0.0.0.0，
# 对外服务必须设置 ADMIN_TOKEN；未设置时管理接口仅允许真实回环连接。
#HOST=127.0.0.1

# 监听端口。默认 8787。
# 避让规则：仅当端口保持默认 8787 且被占用时，启动会自动向后避让最多 3 次
# （8788→8789→8790）并在终端打印提示；一旦你显式改成非 8787 的端口，则不再
# 自动避让，被占用时直接报错（尊重你的显式配置）。
#PORT=8787

# 允许非回环 Host 头访问（反向代理 / 容器场景）。默认 false。
#ALLOW_EXTERNAL_HOST=false

# 请求体硬上限（含图片/工具历史），默认 16 MiB；必须大于 0。
# 登录接口单独限制为 8 KiB。请求体读取最多 30 秒，不限制之后的 SSE 时长。
#MAX_REQUEST_BYTES=16777216
# 模型执行并发（含 SSE / 管理台模型测试），硬上限默认 13；管理台另有独立限额。
#MAX_CONCURRENT_REQUESTS=13
# 响应缓冲统一预留预算：流式预留响应字节上限的 2 倍，非流式 4 倍。
# 用户池另保留一个私人非流式请求的预算；不足时公平等待。
#MODEL_BUFFER_BUDGET_BYTES=234881024
# 运行时 Go 在用内存压力闸，不包括可复用的空闲堆页；不等同于 RSS/OS 硬限制。
#MODEL_MEMORY_GUARD=true
#MODEL_MEMORY_HIGH_BYTES=268435456
# 模型排队最多 32，累计等待最多 60 秒（含 WorkBuddy 账号节流 / 重新入池）。
#MODEL_QUEUE_SIZE=32
#MODEL_QUEUE_WAIT_SECONDS=60
# 每个真实 API Key 的等待数；个人 Key 默认可以独占全部空闲执行名额。
#MODEL_KEY_QUEUE_SIZE=16
# 指定分发 Key 的执行上限，JSON 的键为管理台显示的应用 ID；未列出者使用全局上限。
# 不抢占已执行请求，修改配置后重启生效。示例：应用 2 最多同时执行 1，应用 3 最多 2。
#MODEL_KEY_CONCURRENCY_LIMITS={"2":1,"3":2}
#ADMIN_CONCURRENCY=8
#HEAVY_ADMIN_CONCURRENCY=2
#QUERY_CONCURRENCY=4
#BODY_READ_CONCURRENCY=4
# 读取名额忙时有界等待最多 5 秒；等待读取请求数量受 MODEL_QUEUE_SIZE 限制。
# 执行与等待共用原始请求体容量预算（32 MiB，含缓冲区增长时的临时拷贝）。
#REQUEST_BODY_BUDGET=33554432
# 单次上游响应字节上限（8 MiB，SSE 含事件封装），限制聚合与转换的内存放大。
# 长输出需要适当调高，并结合模型并发重新验证进程峰值内存。
#MAX_RESPONSE_BYTES=8388608
# JSON 结构符号数量与嵌套深度上限，防止少量原始字节解码成海量对象。
# 字符串内部的工具参数、图片数据和长文本不计入结构符号。
#MAX_JSON_ITEMS=100000
#MAX_JSON_DEPTH=128


# ---- 鉴权 ----------------------------------------------------------

# 管理后台 / WebUI 的访问令牌。推理 API 使用管理台创建的独立 API Key。
# 留空 = 管理接口仅允许真实回环连接。
# 对外提供服务时务必设置一个足够随机的值。
#ADMIN_TOKEN=

# ALLOW_EXTERNAL_HOST=true 时默认强制 Secure Cookie，支持 HTTPS 代理 HTTP 回源。
# 本机模式默认 false；直连 TLS 始终 Secure。不信任 X-Forwarded-Proto。
# 仅可信局域网直接使用 HTTP 时才设 false；公网须保持 true 并使用 HTTPS。
#ADMIN_COOKIE_SECURE=true


# ---- 数据与日志 ----------------------------------------------------

# 数据目录（数据库、附件、密钥等）。相对路径相对于工作目录。默认 data。
#DATA_DIR=data

# SQLite 数据库文件路径。留空 = <DATA_DIR>/work2api.db。
#DB_PATH=

# 日志级别：DEBUG / INFO / WARN / ERROR。默认 INFO。
#LOG_LEVEL=INFO

# 是否同时写日志文件。1=写（默认），0=只输出到终端。
#LOG_TO_FILE=1


# ---- 请求脱敏 / 限流 ----------------------------------------------

# 日志中对敏感内容脱敏。默认 true。
#DESENSITIZE=true

# 消息压缩（/v1/responses 专用）：把 Codex CLI 的 agentic 请求（海量运行时提示/
# 工具 schema/长历史）投影成最小语义上下文，显著省 token 并降低触发上游内容审核
# 的概率。有损压缩：早期历史变摘要，需要精确旧细节时模型会重跑工具。默认 false。
#OPTIMIZE_CONTEXT=false

# 启用上游请求限流。默认 true。
#RATELIMIT=true

# 限流最小间隔（秒）。默认 1.5。
#RATELIMIT_INTERVAL=1.5


# ---- 定时任务（整点小时用 0–23；多个用英文逗号分隔）----------------
# 这些也可在 WebUI「设置」页在线修改，一般无需在此配置。

# 自动签到时间。默认 9,21。
#CHECKIN_HOURS=9,21

# 账号额度刷新间隔（分钟）。默认 30。
#CREDIT_REFRESH_MIN=30

# 模型目录刷新时间（小时）。默认 6。
#MODEL_REFRESH_HOUR=6

# Token 保活时间（小时）。默认 22。
#KEEPALIVE_HOUR=22


# ---- 用量记录清理 --------------------------------------------------

# 用量日志保留天数。默认 90。<=0 视为不按天清理（不会清空）。
#USAGE_RETENTION_DAYS=90

# 用量日志总行数上限。默认 100000（0=不限）。防止高频调用撑爆数据库。
#USAGE_MAX_ROWS=100000

# 行数上限的检查间隔（分钟）。默认 30。
#USAGE_CHECK_INTERVAL_MIN=30

# 单条 input/output/reasoning 内容的最大字节数。默认 32768（32KB，0=不限）。
# 主要用于截断 base64 图片这类超大 payload。
#USAGE_CONTENT_MAX_BYTES=32768

# ---- 用户门户执行和等待（多 Key 按用户合并） ----
#PORTAL_USER_CONCURRENCY=4
#PORTAL_SHARED_CONCURRENCY=12
#PORTAL_USER_QUEUE_SIZE=6
#PORTAL_SHARED_QUEUE_SIZE=28
# 每个 WorkBuddy 账号 UID 同时最多执行 4 个请求；私人/共享、用户与模型统一计数。
# 先沿用粘性/成本/到期额度/权重选号，再等待所选账号名额；忙碌不触发换号。
# 等待不占全局执行槽，真实不可用或上游失败仍按原机制换号。
# 更多账号增加可用容量，始终受共享/用户/服务器硬上限保护；0 使用默认值 4。
#WORKBUDDY_ACCOUNT_CONCURRENCY=4
# MODEL_QUEUE_WAIT_SECONDS 可设为 60；需保证 EdgeOne 回源超时覆盖排队和首包耗时。
# 每日预算默认 0（不限）；可信用户并发可在管理门户单独设置。

# 小内存服务器可设置 Go 软内存目标，仍须配合进程硬上限和真实负载验证。
# 须在进程启动前配置到 systemd / shell 环境，仅写本 .env 不会应用 Go 内存目标。
#GOMEMLIMIT=192MiB

# 完整备份默认关闭，在管理台设置中启用每日任务（最近 7 份）。
# 如需同时恢复服务器反代/证书/systemd 配置，用 JSON 数组指定实际文件路径。
# 显式指定路径不存在时备份失败；不支持符号链接；归档含敏感配置。
#BACKUP_EXTRA_PATHS=["/etc/work2api/service.env","/etc/nginx/conf.d/work2api.conf"]
# 外部环境文件的备份路径；不是 .env 加载选项。
#ENV_FILE=/etc/work2api/service.env
# Qoder 自动签到/额度维护为管理台独立开关，默认关闭，无额外常驻调度进程。